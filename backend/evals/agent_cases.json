{
  "description": "FINORA agent benchmark. Each case is scored on (1) choosing the right engine tool, (2) passing the right arguments, (3) a fully grounded final answer. 'turns' are asked in order with the returned context carried forward; only the last turn is scored. 'paraphrase' marks wording the deterministic planner was not written for.",
  "cases": [
    {"id": "buy-01", "category": "purchase", "question": "What happens if I buy a laptop worth ₹75,000 this month?", "expect": {"tool": "compare_payment_options", "args": {"amount": 75000}}},
