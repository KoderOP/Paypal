    {"id": "pay-01", "category": "checkout", "question": "Pay with PayPal for a ₹75,000 laptop using Pay in 4", "expect": {"tool": "prepare_paypal_checkout", "args": {"amount": 75000, "option_id": "pay_in_4"}}},
    {"id": "pay-02", "category": "checkout", "turns": ["Should I buy a ₹75,000 laptop?", "OK, go ahead with Pay in 4"], "expect": {"tool": "prepare_paypal_checkout", "args": {"amount": 75000, "option_id": "pay_in_4"}}},
    {"id": "pay-03", "category": "checkout", "turns": ["Can I afford a ₹40,000 phone?", "Fine, pay for it in full now"], "expect": {"tool": "prepare_paypal_checkout", "args": {"amount": 40000, "option_id": "pay_now"}}},
