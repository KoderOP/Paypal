    {"id": "aff-04", "category": "affordability", "paraphrase": true, "question": "What's my spending headroom before payday?", "expect": {"tool": "find_affordability"}},
    {"id": "aff-05", "category": "affordability", "paraphrase": true, "question": "Earliest date I could drop ₹60,000 on a sofa?", "expect": {"tool": "find_affordability", "args": {"amount": 60000}}},

    {"id": "scn-01", "category": "scenario", "question": "What if I cancel three subscriptions?", "expect": {"tool": "simulate_scenario", "changes": [{"type": "cancel_subscriptions"}]}},
    {"id": "scn-02", "category": "scenario", "question": "What if my income is delayed by 15 days?", "expect": {"tool": "simulate_scenario", "changes": [{"type": "income_delay", "days": 15}]}},
    {"id": "scn-03", "category": "scenario", "question": "What if I increase my monthly savings by 10%?", "expect": {"tool": "simulate_scenario", "changes": [{"type": "increase_savings", "percent": 10}]}},
    {"id": "scn-04", "category": "scenario", "question": "What if I add a ₹499/month gym membership?", "expect": {"tool": "simulate_scenario", "changes": [{"type": "add_subscription", "amount": 499}]}},
    {"id": "scn-05", "category": "scenario", "question": "What if I lose my job for 2 months?", "expect": {"tool": "simulate_scenario", "changes": [{"type": "income_loss", "months": 2}]}},
    {"id": "scn-06", "category": "scenario", "question": "What if I cancel Netflix and Spotify and my salary is 2 weeks late?", "expect": {"tool": "simulate_scenario", "changes": [{"type": "cancel_subscriptions"}, {"type": "income_delay", "days": 14}]}},
    {"id": "scn-07", "category": "scenario", "question": "What if I have a ₹30,000 medical emergency next week?", "expect": {"tool": "simulate_scenario", "changes": [{"type": "unexpected_payment", "amount": 30000}]}},
