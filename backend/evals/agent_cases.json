    {"id": "buy-05", "category": "purchase", "paraphrase": true, "question": "My sister's wedding gift will be around twenty-five thousand rupees, is that ok right now?", "expect": {"tool": "compare_payment_options", "args": {"amount": 25000}}},
    {"id": "buy-06", "category": "purchase", "paraphrase": true, "question": "Is splurging 90000 on a new camera a bad idea?", "expect": {"tool": "compare_payment_options", "args": {"amount": 90000}}},

