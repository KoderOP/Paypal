    {"id": "fu-01", "category": "follow_up", "turns": ["What if I cancel three subscriptions?", "And what if my salary is also 10 days late?"], "expect": {"tool": "simulate_scenario", "changes": [{"type": "cancel_subscriptions"}, {"type": "income_delay", "days": 10}]}},
    {"id": "fu-02", "category": "follow_up", "turns": ["What if my income is delayed by 15 days?", "What about 20 days?"], "expect": {"tool": "simulate_scenario", "changes": [{"type": "income_delay", "days": 20}]}},
    {"id": "fu-03", "category": "follow_up", "turns": ["Can I afford a ₹40,000 phone?", "What about ₹60,000?"], "expect": {"tool": "compare_payment_options", "args": {"amount": 60000}}},
    {"id": "fu-04", "category": "follow_up", "paraphrase": true, "turns": ["What if I add a ₹499/month gym membership?", "Make it the ₹999 premium tier instead"], "expect": {"tool": "simulate_scenario", "changes": [{"type": "add_subscription", "amount": 999}]}}
