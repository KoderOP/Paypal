# ---- Backend (FastAPI) ---------------------------------------------------
# Local default is SQLite; docker-compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./finora.db
# DATABASE_URL=postgresql+psycopg://finora:finora@localhost:5432/finora
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development

# Seed for the downloadable synthetic demo files (no data is ever auto-seeded).
DEMO_SEED=42

# Forecast defaults
FORECAST_HORIZON_DAYS=90
DEFAULT_SAFETY_BUFFER=20000

# Public URL of the web app. PayPal redirects back to <FRONTEND_URL>/api/... (Vite proxies /api).
FRONTEND_URL=http://localhost:5173

# Optional Sign in with PayPal (open to any PayPal account; every feature works without it).
# Set a long random value so sign-ins survive backend restarts.
SESSION_SECRET=
SESSION_MAX_AGE_DAYS=7

# AI agent — server-side only. Groq is the primary provider (free tier works): https://console.groq.com/keys
# Without a key, a deterministic planner answers the core questions with the same engine tools.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Used automatically if the primary model is unavailable on your account.
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
# auto (Groq if its key is set, else OpenAI) | groq | openai | none
LLM_PROVIDER=auto
CHAT_RATE_LIMIT_PER_MINUTE=20
# Optional: any other OpenAI-compatible endpoint.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# PayPal Developer (sandbox) — server-side only. Powers Transaction Search sync, checkout
# (Orders API), Subscriptions API and Sign in with PayPal. In the sandbox app enable
# "Transaction Search" and "Log in with PayPal" (return URL: <FRONTEND_URL>/api/auth/paypal/callback).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Checkout currency. Empty = the profile currency (INR). Use e.g. USD if your sandbox account can't take INR.
PAYPAL_CHECKOUT_CURRENCY=
# With no PayPal credentials, FINORA uses its built-in PayPal demo so every feature works (sync,
# checkout, Pay Later, subscriptions, sign-in), clearly labelled and with no real money. Set to
# false to turn PayPal features off instead when credentials are missing.
PAYPAL_DEMO_MODE=true

# ---- Frontend (Vite) -----------------------------------------------------
# Dev proxy target for /api. Leave VITE_API_BASE_URL empty to use the proxy.
VITE_API_PROXY_TARGET=http://localhost:8000
VITE_API_BASE_URL=
