# ---- Backend (FastAPI) ---------------------------------------------------
# Local default is SQLite; docker-compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./finora.db
# DATABASE_URL=postgresql+psycopg://finora:finora@localhost:5432/finora
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development

# Seed for the downloadable synthetic demo files (no data is ever auto-seeded).
DEMO_SEED=42

# Forecast defaults
FORECAST_HORIZON_DAYS=90
DEFAULT_SAFETY_BUFFER=20000

# AI layer (next milestone) — server-side only, never exposed to the frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# PayPal Developer (sandbox) — server-side only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ---- Frontend (Vite) -----------------------------------------------------
# Dev proxy target for /api. Leave VITE_API_BASE_URL empty to use the proxy.
VITE_API_PROXY_TARGET=http://localhost:8000
VITE_API_BASE_URL=
